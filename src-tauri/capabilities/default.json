{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Nur die Rechte, die die Oberfläche wirklich braucht. Dateien schreiben nur in Dokumente, Schreibtisch, Downloads und den in den Einstellungen gewählten Ablageordner (wird zur Laufzeit freigegeben).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }]
    }
  ]
}
